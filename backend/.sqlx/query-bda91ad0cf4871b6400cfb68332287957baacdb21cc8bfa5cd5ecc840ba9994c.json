{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.event_id, u.id, u.username, u.display_name\n        FROM event_interests i\n        JOIN friends f ON f.user_id = $2 AND f.friend_id = i.user_id\n        JOIN users u ON u.id = i.user_id\n        WHERE i.event_id = ANY($1)\n        ORDER BY i.created_at\n        ",
