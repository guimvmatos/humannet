  "query": "\n        WITH c AS (\n          INSERT INTO comments (id, post_id, author_id, body) VALUES ($1, $2, $3, $4)\n          RETURNING id, post_id, body, created_at\n        )\n        SELECT c.id, c.post_id, c.body, c.created_at, u.username, u.display_name\n        FROM c JOIN users u ON u.id = $3\n        ",
