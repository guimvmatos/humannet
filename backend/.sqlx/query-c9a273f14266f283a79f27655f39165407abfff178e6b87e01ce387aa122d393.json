  "query": "\n        UPDATE users SET\n          display_name = CASE WHEN $2 THEN $3 ELSE display_name END,\n          bio          = COALESCE($4, bio),\n          hometown     = COALESCE($5, hometown),\n          city         = COALESCE($6, city),\n          school       = COALESCE($7, school)\n        WHERE id = $1\n        RETURNING id, username, email, display_name, bio, role, created_at\n        ",
