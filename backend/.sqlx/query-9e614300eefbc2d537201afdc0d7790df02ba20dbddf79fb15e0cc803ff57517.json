  "query": "\n        SELECT r.user_id, r.code_hash, r.attempts\n        FROM password_resets r JOIN users u ON u.id = r.user_id\n        WHERE u.username = $1 AND r.expires_at > now()\n        FOR UPDATE OF r\n        ",
