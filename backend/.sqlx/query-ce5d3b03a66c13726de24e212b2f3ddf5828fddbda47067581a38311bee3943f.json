  "query": "\n        SELECT u.id, u.username, u.display_name, r.created_at\n        FROM friend_requests r JOIN users u ON u.id = r.from_id\n        WHERE r.to_id = $1\n        ORDER BY r.created_at DESC\n        LIMIT 200\n        ",
