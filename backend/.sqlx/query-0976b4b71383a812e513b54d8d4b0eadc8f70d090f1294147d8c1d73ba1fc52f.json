{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.username, u.display_name, u.bio, u.created_at,\n               EXISTS (SELECT 1 FROM follows f\n                       WHERE f.follower_id = $2 AND f.followee_id = u.id) AS \"is_following!\"\n        FROM users u\n        WHERE u.id = $1\n        ",
