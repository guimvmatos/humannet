  "query": "\n        WITH g AS (\n          INSERT INTO messages (id, conversation_id, author_id, body, as_page)\n          VALUES ($1, $2, $3, $4, $5)\n          RETURNING id, body, created_at\n        )\n        SELECT g.id, g.body, g.created_at, u.username, u.display_name\n        FROM g JOIN users u ON u.id = $3\n        ",
