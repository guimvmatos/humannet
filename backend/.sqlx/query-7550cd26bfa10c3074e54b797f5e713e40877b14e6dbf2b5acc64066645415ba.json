  "query": "\n        SELECT u.id, u.username, u.display_name, NULL::text AS avatar_url\n        FROM blocks b JOIN users u ON u.id = b.blocked_id\n        WHERE b.blocker_id = $1\n        ORDER BY b.created_at DESC\n        ",
