{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id AS \"id!\", u.username AS \"username!\", u.display_name,\n               u.status_text AS \"status_text!\", u.status_expires_at\n        FROM friends f JOIN users u ON u.id = f.friend_id\n        WHERE f.user_id = $1\n        ORDER BY lower(coalesce(u.display_name, u.username))\n        LIMIT 1000\n        ",
