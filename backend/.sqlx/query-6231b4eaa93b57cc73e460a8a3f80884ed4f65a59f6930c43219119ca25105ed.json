{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.mention_policy,\n               EXISTS (SELECT 1 FROM friends f WHERE f.user_id = u.id AND f.friend_id = $2)\n                 AS \"friend!\"\n        FROM users u\n        WHERE u.username = ANY($1) AND u.id <> $2 AND u.suspended_at IS NULL\n        ",
