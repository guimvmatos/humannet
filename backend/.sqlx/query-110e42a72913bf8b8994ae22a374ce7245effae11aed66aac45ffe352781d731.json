  "query": "SELECT d.day, d.caption, m.id, m.key, m.width, m.height\n         FROM daily_photos d JOIN media m ON m.id = d.media_id\n         WHERE d.user_id = $1 AND d.day > $2\n         ORDER BY d.day DESC LIMIT 1",
